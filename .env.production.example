# Leonardo (leonardoaderito-cmyk): modelo do .env do servidor de producao.
# O scripts/instalar.ps1 copia-o para .env; depois preencher os valores marcados com <...>.
# Nunca colocar o .env real no Git.

APP_NAME="CDA Digital"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cda.bhub360.app

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# Base de dados SQLite, caminho absoluto com barras /. O scripts/instalar.ps1 preenche-o sozinho.
DB_CONNECTION=sqlite
DB_DATABASE=C:/inetpub/cda-digital/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# As notificacoes sao enviadas logo, sem fila: nao e preciso worker
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Email real (SMTP da CDA). Sem isto, credenciais e recuperacao de senha nao chegam aos membros.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<servidor-smtp>
MAIL_PORT=587
MAIL_USERNAME=<utilizador-smtp>
MAIL_PASSWORD=<senha-smtp>
MAIL_FROM_ADDRESS="no-reply@bhub360.app"
MAIL_FROM_NAME="${APP_NAME}"

# Proxies de confianca. Deixar vazio se o PHP recebe os pedidos directamente.
# cda.bhub360.app passa pelo Cloudflare: "*" (ou a lista de IPs do Cloudflare separados por virgulas).
TRUSTED_PROXIES="*"

# Copias de seguranca (tarefa agendada do Windows criada por scripts/instalar.ps1, todos os dias as 02:00)
CDA_COPIAS_PASTA=C:/copias/cda-digital
CDA_COPIAS_MANTER=14

# Assistente CDA: motor proprio do portal, sem servicos externos. Perguntas por minuto por visitante.
CDA_ASSISTENTE_POR_MINUTO=20

VITE_APP_NAME="${APP_NAME}"
